---
// The shared page shell: SEO head from props, the GA4 snippet, font preloads, skip link,
// header, <main id="main-content">, footer, and the two site-wide scripts.
//
//   <Base title="…" description="…" path="/artist-booking/" jsonLd={[service, breadcrumbs, faq]}>
//     …page content…
//   </Base>
//
// Head values are frozen by the SEO plan (build-tools/seo-targets.json); pass them, do not
// improvise them. `path` is the canonical path with its trailing slash. For the 404 page pass
// `noindex`: it gets "noindex, follow" and no canonical / Open Graph / Twitter / geo tags,
// which is the shape production serves.
// `footer="compact"`: the short footer (logo, contact routes, legal), for a page whose body
// already lists every page (the 404).
// Fonts: the two roman faces are preloaded here. The italic is preloaded by <Hero> when its
// headline has an <em>; a page that opens without <Hero> and sets an italic in its first view
// adds the same <link rel="preload"> through slot="head".
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import anekUrl from '../assets/fonts/anek-latin-var.woff2?url';
import newsreaderUrl from '../assets/fonts/newsreader-var.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  robots?: string;
  noindex?: boolean;
  og?: { title?: string; description?: string; type?: 'website' | 'article'; image?: string; imageAlt?: string };
  twitter?: { title?: string; description?: string; image?: string; imageAlt?: string };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  footer?: 'full' | 'compact';
}
const { title, description, path, robots = site.robots, noindex = false, og = {}, twitter = {}, jsonLd, footer = 'full' } = Astro.props;

const canonical = new URL(path, site.url).href;
const card = site.ogCards[path];
const ogImage = og.image ?? new URL(card?.path ?? site.ogImage.path, site.url).href;
const ogImageAlt = og.imageAlt ?? card?.alt;
const twImage = twitter.image ?? ogImage;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* The header controls drop in on the first page of a visit only (Header.astro). Runs before
        the first paint; if storage is blocked the entrance simply plays every time. */}
    <script is:inline>
      try {
        if (sessionStorage.getItem('tsc-visit')) document.documentElement.classList.add('is-return');
        else sessionStorage.setItem('tsc-visit', '1');
      } catch (e) {}
    </script>

    {/* GA4, exactly as production's homepage serves it (site-contract.md §5): the stub runs
        synchronously, the network script waits for load + idle. `is:inline` keeps `gtag` a
        classic global. Left out of `astro dev` so local work never reaches the real property. */}
    {
      import.meta.env.PROD && (
        <Fragment>
          <script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-Y5FKNQX4H0');

  function loadGA() {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-Y5FKNQX4H0';
    document.head.appendChild(s);
  }
  window.addEventListener('load', function () {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadGA, { timeout: 2000 });
    } else {
      setTimeout(loadGA, 2000);
    }
  });
          </script>
        </Fragment>
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : robots} />
    <meta name="theme-color" content={site.themeColor} />
    {
      !noindex && (
        <Fragment>
          <meta name="geo.region" content="IN" />
          <meta name="geo.placename" content="India" />
        </Fragment>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/assets/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/assets/logo.png?v=2" />
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="preload" as="font" type="font/woff2" href={anekUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderUrl} crossorigin />

    {
      !noindex && (
        <Fragment>
          <meta property="og:type" content={og.type ?? 'website'} />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:locale" content={site.ogLocale} />
          <meta property="og:title" content={og.title ?? title} />
          <meta property="og:description" content={og.description ?? description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={ogImage} />
          {!og.image && <meta property="og:image:width" content={String(site.ogImage.width)} />}
          {!og.image && <meta property="og:image:height" content={String(site.ogImage.height)} />}
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:site" content={site.twitterSite} />
          <meta name="twitter:title" content={twitter.title ?? og.title ?? title} />
          <meta name="twitter:description" content={twitter.description ?? og.description ?? description} />
          <meta name="twitter:image" content={twImage} />
          {(twitter.imageAlt ?? ogImageAlt) && <meta name="twitter:image:alt" content={twitter.imageAlt ?? ogImageAlt} />}
        </Fragment>
      )
    }

    {ld.map((entity) => <script type="application/ld+json" set:html={JSON.stringify(entity)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header pathname={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer compact={footer === 'compact'} />
    <script>
      import '../client/motion';
      import '../client/ui';
    </script>
  </body>
</html>
