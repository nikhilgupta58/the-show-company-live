---
// A service as a ruled row. The whole row is clickable, but the link itself is short: by default
// the service name, or the `cta` text when the copy deck gives one ("Book a stand-up comedian").
// On a desktop it is one low line: the name on the left edge; from column 5 one or two lines of
// text with the link text directly under them; the arrow alone at the outer edge (about 130px a
// row with a link text, 104px without, so six rows are under a screen). On a phone it stacks:
// name and arrow, text, link.
// Hover or focus "lights" the row: the name goes gold, a gold rule draws across, the arrow fills.
// Use rows (not cards) wherever a service has no real photograph of its own.
// Keep the slot to one or two short lines: it is a <p>.
import Icon from './Icon.astro';
interface Props {
  href: string;
  name: string;
  kicker?: string; // a real qualifier from the copy, e.g. "For companies"
  cta?: string; // link text; when absent the name is the link
  level?: 3 | 4;
}
const { href, name, kicker, cta, level = 3 } = Astro.props;
const H = `h${level}` as 'h3' | 'h4';
---

<article class="srow">
  <div class="srow__head">
    {kicker && <span class="t-label srow__kicker">{kicker}</span>}
    <H class="srow__name">{cta ? name : <a class="srow__link" href={href}>{name}</a>}</H>
  </div>
  <p class="srow__text"><slot /></p>
  {cta && <a class="srow__link srow__cta" href={href}>{cta}</a>}
  <span class="srow__go" aria-hidden="true"><Icon name="arrow-right" /></span>
</article>

<style>
  .srow {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-3) var(--s-5);
    align-items: start;
    padding-block: var(--s-5);
    border-block-start: 1px solid var(--rule);
  }
  .srow:last-of-type {
    border-block-end: 1px solid var(--rule);
  }
  .srow__link {
    color: inherit;
    text-decoration: none;
  }
  /* Stretch the link over the whole row. */
  .srow__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .srow__link:focus-visible {
    outline: none;
  }
  .srow:has(.srow__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  /* The lit rule: a gold copy of the hairline that draws across on hover / focus. */
  .srow::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto 0;
    block-size: 1px;
    background: linear-gradient(90deg, var(--gold-100), var(--gold-400) 60%, transparent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 700ms var(--ease-expo);
  }
  .srow__head {
    display: grid;
    gap: var(--s-1);
  }
  .srow__name {
    font-family: var(--font-serif);
    font-size: var(--t-title);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.01em;
    transition: color var(--dur-ui) ease;
  }
  .srow__text {
    grid-column: 1 / -1;
    color: var(--text-2);
    max-inline-size: 31.7em; /* 56ch of Anek Latin */
  }
  /* The link text sits under the description; the arrow beside the name (phone) or at the outer
     edge (desktop). */
  .srow__cta {
    grid-column: 1 / -1;
    justify-self: start;
    font-weight: 500;
    font-stretch: 112%;
    line-height: 1.3;
    color: var(--ivory);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.3em;
  }
  .srow__go {
    grid-area: 1 / 2;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: var(--r-control);
    color: var(--gold-200); /* a bare arrow at rest (a ring on every row is noise); it fills on hover */
    transition:
      background-color var(--dur-ui) ease,
      color var(--dur-ui) ease,
      transform 420ms var(--ease-expo);
  }
  .srow:focus-within::before {
    transform: scaleX(1);
  }
  .srow:focus-within .srow__name {
    color: var(--gold-200);
  }
  @media (hover: hover) and (pointer: fine) {
    .srow:hover::before {
      transform: scaleX(1);
    }
    .srow:hover .srow__name {
      color: var(--gold-200);
    }
    .srow:hover .srow__go {
      background: var(--gold-300);
      color: var(--black);
    }
    @media (prefers-reduced-motion: no-preference) {
      .srow:hover .srow__go {
        transform: translateX(0.35rem);
      }
    }
  }
  .srow:active .srow__go {
    transform: scale(0.95);
  }
  @media (min-width: 56rem) {
    .srow {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--s-2) var(--gutter);
      align-items: center;
      padding-block: clamp(1rem, 1.5vw, 1.375rem);
    }
    .srow:has(.srow__cta) {
      grid-template-rows: auto auto;
    }
    .srow__head {
      grid-column: 1 / span 4;
      grid-row: 1 / -1;
    }
    .srow__text {
      grid-column: 5 / span 6;
      grid-row: 1;
    }
    .srow__cta {
      grid-column: 5 / span 6;
      grid-row: 2;
    }
    .srow__go {
      grid-area: auto;
      grid-column: 12;
      grid-row: 1 / -1;
      justify-self: end;
    }
  }
</style>
