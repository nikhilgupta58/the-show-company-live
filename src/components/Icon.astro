---
// Inline SVG icons: one weight (1.5px), round joins, drawn on a 24 grid, coloured by currentColor.
// Decorative by default (aria-hidden); the control that holds it carries the accessible name.
// No icon font and no CDN (the old build's Iconify is gone, and with it a CSP violation).
const paths = {
  'arrow-right': '<path d="M4 12h16M14 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H4M10 6l-6 6 6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M4 9h16M4 15h16"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  phone:
    '<path d="M6.2 3.5h3.1l1.6 4.2-2 1.4a12 12 0 0 0 6 6l1.4-2 4.2 1.6v3.1a2 2 0 0 1-2.2 2A17.3 17.3 0 0 1 4.200 5.700a2 2 0 0 1 2-2.200z"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.500 7l8.500 6 8.500-6"/>',
  whatsapp:
    '<path d="M12 3.200a8.800 8.800 0 0 0-7.600 13.200L3.200 20.800l4.500-1.200A8.800 8.800 0 1 0 12 3.200z"/><path d="M9.200 8.300c-.300 2.900 2.600 6.200 6 6.700l1.100-1.400-1.900-1-.9.800c-1-.500-1.900-1.400-2.300-2.400l.8-.9-.900-1.900z"/>',
  instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4.500"/><circle cx="12" cy="12" r="3.600"/><circle cx="16.700" cy="7.300" r=".7" fill="currentColor" stroke="none"/>',
} as const;

export type IconName = keyof typeof paths;
interface Props {
  name: IconName;
  size?: string;
  class?: string;
}
const { name, size = '1.25em', class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  style={`inline-size:${size};block-size:${size}`}
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: -0.2em;
  }
</style>
