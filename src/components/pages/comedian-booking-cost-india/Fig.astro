---
// A price set as type. The numerals carry the figure's own colour; the rupee sign and the K / L
// unit step back a tone (and the unit a size), so the eye lands on the numbers first.
// The text is untouched ("₹50K – ₹1.5L" stays "₹50K – ₹1.5L"), so search engines, the judge and
// screen readers read the figure exactly as the facts ledger writes it.
interface Props {
  value: string;
  class?: string;
}
const { value, class: className } = Astro.props;
// "₹50K – ₹1.5L" -> ₹ | 50 | K | " – " | ₹ | 1.5 | L. A K or L is a unit only straight after a digit.
const parts = value.split(/(₹|(?<=\d)[KL])/).filter(Boolean);
---

<span class:list={['fig', className]}>{parts.map((p) => (p === '₹' ? <span class="fig__cur">{p}</span> : p === 'K' || p === 'L' ? <span class="fig__unit">{p}</span> : p))}</span>

<style>
  .fig {
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
  .fig__cur,
  .fig__unit {
    color: var(--gold-500);
  }
  .fig__cur {
    margin-inline-end: 0.04em;
  }
  .fig__unit {
    margin-inline-start: 0.03em;
    font-size: 0.74em;
  }
</style>
