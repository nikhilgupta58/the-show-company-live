---
// A service (or a show type) as a picture card, or, without `photo`, a text card under a rule
// (used where no unused photograph is left: no repeats). The photo is a full-brightness window; the words sit under it, never on it. The whole card
// is clickable. The link itself is the name, or, with `linkLabel`, a short text link under the
// line of copy (use it when the strategy gives the link its own anchor phrase, e.g. "Book a
// stand-up comedian"). Inside a <Scroller> the cards run sideways and their curtains are drawn
// aside one after another; in a grid they sit four across.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import type { Photograph } from '../data/photos';
interface Props {
  href: string;
  name: string;
  photo?: Photograph;
  ratio?: '4/5' | '3/2' | '2/3';
  kicker?: string;
  sizes?: string;
  level?: 3 | 4;
  linkLabel?: string; // the link's own text; when absent the name is the link
}
const { href, name, photo, ratio = '4/5', kicker, sizes = '(min-width: 64rem) 25vw, (min-width: 40rem) 45vw, 78vw', level = 3, linkLabel } = Astro.props;
const H = `h${level}` as 'h3' | 'h4';
---

<article class:list={['scard', { 'scard--text': !photo }]}>
  {photo && <Photo photo={photo} ratio={ratio} sizes={sizes} widths={[360, 540, 720, 960, 1280, 1600]} class="scard__photo" reveal />}
  <div class="scard__body">
    <div class="scard__head">
      {kicker && <span class="t-label">{kicker}</span>}
      <H class="scard__name">{linkLabel ? name : <a class="scard__link" href={href}>{name}</a>}</H>
    </div>
    {/* arrow-right: these are pages of this site (arrow-up-right would say "leaves the site"). */}
    <Icon name="arrow-right" class="scard__go" />
  </div>
  <p class="scard__text t-small"><slot /></p>
  {linkLabel && <a class="scard__link scard__cta" href={href}>{linkLabel}</a>}
</article>

<style>
  .scard {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    position: relative;
  }
  .scard--text {
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--rule-strong);
  }
  .scard__link {
    color: inherit;
    text-decoration: none;
  }
  .scard__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .scard__cta {
    justify-self: start;
    margin-block-start: calc(-1 * var(--s-2));
    font-weight: 500;
    font-stretch: 112%;
    font-size: var(--t-small);
    line-height: 1.3;
    color: var(--ivory);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.3em;
  }
  .scard__link:focus-visible {
    outline: none;
  }
  .scard:has(.scard__link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .scard__body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block-start: var(--s-1);
  }
  .scard__head {
    display: grid;
    gap: var(--s-2);
  }
  .scard__name {
    font-family: var(--font-serif);
    font-size: var(--t-title);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    transition: color var(--dur-ui) ease;
  }
  .scard :global(.scard__go) {
    flex: none;
    color: var(--gold-300);
    transition: transform 420ms var(--ease-expo);
  }
  .scard__text {
    color: var(--text-2);
    max-inline-size: 20.4em; /* 36ch of Anek Latin */
  }
  .scard :global(.photo__img) {
    transition: transform 900ms var(--ease-expo);
  }
  .scard:focus-within .scard__name {
    color: var(--gold-200);
  }
  @media (hover: hover) and (pointer: fine) {
    .scard:hover .scard__name {
      color: var(--gold-200);
    }
    @media (prefers-reduced-motion: no-preference) {
      .scard:hover :global(.photo__img) {
        transform: scale(1.04);
      }
      .scard:hover :global(.scard__go) {
        transform: translateX(0.25rem);
      }
    }
  }
</style>
