---
// The enquiry: production's two forms (booking, general query) as two tabs.
// Field names, ids, options and the EmailJS pipeline are production's (site-contract.md §6,
// content/index.md §4). Behaviour: src/client/enquiry.ts.
//   · both forms are in the DOM; without JavaScript they stack and a note sends people to
//     call / WhatsApp / email, since EmailJS cannot send without JavaScript. The send buttons
//     carry formmethod="dialog", so a native submit (no script) goes nowhere instead of writing
//     the visitor's details into the address bar. The <form> elements keep production's
//     attributes (the judge compares them)
//   · each form is named by its panel heading (a form landmark)
//   · blocked sends are explained under each field (aria-invalid + a message), not by the
//     browser's bubble
//   · a honeypot field (`website`) no person can see or reach
//   · on failure the button recovers and the three direct routes appear in place
// The reply promise and the two direct routes sit beside the send button (the moment of
// commitment), in the ledger's words. The wrapping section, its heading and id="contact" belong
// to the page. Labels, placeholders and options are production's, unchanged (strategy §6.10).
import Tabs from './Tabs.astro';
import TabPanel from './TabPanel.astro';
import Field from './Field.astro';
import Button from './Button.astro';
import { site } from '../data/site';

const { contact } = site;
// The failure note is written by enquiry.ts from these attributes when a send fails, so no
// text sits hidden in the page until then.
const routes = JSON.stringify([
  { href: contact.phone.href, label: `Call ${contact.phone.label}` },
  { href: contact.whatsapp.href, label: 'WhatsApp us', external: true },
  { href: contact.email.href, label: contact.email.label },
]);
const subjects = [
  { value: '', label: 'Select a topic' },
  { value: 'General Inquiry', label: 'General Inquiry' },
  { value: 'Book a Show', label: 'Book a Show' },
  { value: 'Partnership', label: 'Partnership' },
  { value: 'Artist Collaboration', label: 'Artist Collaboration' },
];
---

<div class="enquiry" data-dock-away>
  <Tabs label="What would you like to do?">
    <TabPanel id="form-booking" label="Book a Show / Artist">
      <p class="enquiry__intro dim">Fill this form to enquire about artist availability and pricing.</p>
      <form class="form" id="booking-form" data-enquiry="booking" aria-labelledby="form-booking-heading">
        <div class="form__grid">
          <Field id="bk-name" name="name" label="Your Name *" required placeholder="Enter Your Name" autocomplete="name" />
          <Field id="bk-organization" name="organization" label="Organization / College *" required placeholder="Enter Organization / College" autocomplete="organization" />
          <Field id="bk-email" name="email" type="email" label="Email Address *" required placeholder="Enter Email Address" autocomplete="email" inputmode="email" />
          <Field id="bk-phone" name="phone" type="tel" label="Phone Number *" required placeholder="Enter Phone Number" autocomplete="tel" inputmode="tel" />
          <Field id="bk-artist_preference" name="artist_preference" label="Artist / Genre Preference *" required placeholder="Enter Artist / Genre Preference (e.g. Standup Comedy, EDM DJ, Rock Band)" wide />
          <Field id="bk-event_date" name="event_date" type="date" label="Event Date *" required />
          <Field id="budget-input" name="budget" label="Approx. Budget (₹)" placeholder="Enter Budget" prefix="₹" inputmode="numeric" hint="Optional" data-budget />
        </div>
        <div class="form__trap" aria-hidden="true">
          <label for="bk-website">Leave this field empty</label>
          <input id="bk-website" name="website" type="text" tabindex="-1" autocomplete="off" data-form-trap />
        </div>
        <div class="form__foot">
          <Button type="submit" formmethod="dialog">Send Enquiry</Button>
          <p class="form__promise t-small">
            We reply within 24 hours. Or <a class="link tnum" href={contact.phone.href}>call {contact.phone.label}</a>&nbsp;·
            <a class="link" href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer">{contact.whatsapp.label}</a>
          </p>
          <p class="form__req t-small dimmer">Fields marked * are required</p>
        </div>
        <p class="form__status t-small" data-form-status role="status" aria-live="polite"></p>
        <div class="form__fallback" data-form-fallback role="alert" tabindex="-1" hidden data-lead="That did not send." data-text="Your details are still in the form. Try again, or reach us directly:" data-routes={routes}></div>
      </form>
    </TabPanel>

    <TabPanel id="form-query" label="General Query" heading="Customer Query">
      <form class="form" id="query-form" data-enquiry="query" aria-labelledby="form-query-heading">
        <div class="form__grid">
          <Field id="q-name" name="name" label="Name *" required placeholder="Enter Name" autocomplete="name" />
          <Field id="q-email" name="email" type="email" label="Email *" required placeholder="Enter Email" autocomplete="email" inputmode="email" />
          <Field id="q-phone" name="phone" type="tel" label="Phone Number *" required placeholder="Enter Phone Number" autocomplete="tel" inputmode="tel" />
          <Field id="q-subject" name="subject" type="select" label="Subject *" required options={subjects} />
          <Field id="q-message" name="message" type="textarea" label="Message *" required placeholder="Enter Message" wide />
        </div>
        <div class="form__trap" aria-hidden="true">
          <label for="q-website">Leave this field empty</label>
          <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" data-form-trap />
        </div>
        <div class="form__foot">
          <Button type="submit" formmethod="dialog">Send Message</Button>
          <p class="form__promise t-small">
            We reply within 24 hours. Or <a class="link tnum" href={contact.phone.href}>call {contact.phone.label}</a>&nbsp;·
            <a class="link" href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer">{contact.whatsapp.label}</a>
          </p>
          <p class="form__req t-small dimmer">Fields marked * are required</p>
        </div>
        <p class="form__status t-small" data-form-status role="status" aria-live="polite"></p>
        <div class="form__fallback" data-form-fallback role="alert" tabindex="-1" hidden data-lead="That did not send." data-text="Your message is still in the form. Try again, or reach us directly:" data-routes={routes}></div>
      </form>
    </TabPanel>
  </Tabs>

  <noscript>
    <p class="t-small" style="margin-top:1.5rem;color:var(--gold-100)">
      These forms need JavaScript to send. Call <a class="link" href={contact.phone.href}>{contact.phone.label}</a>,
      <a class="link" href={contact.whatsapp.href}>WhatsApp us</a> or email
      <a class="link" href={contact.email.href}>{contact.email.label}</a> instead.
    </p>
  </noscript>
</div>

<script>
  import '../client/enquiry';
</script>

<style>
  .enquiry__intro {
    margin-block-end: var(--s-5);
  }
  .form__grid {
    display: grid;
    gap: var(--s-5) var(--gutter);
  }
  @media (min-width: 40rem) {
    .form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .form__grid :global(.field--wide) {
      grid-column: 1 / -1;
    }
  }
  /* The trap: off screen, out of the tab order, hidden from assistive tech. Not display:none
     (some bots skip those). */
  .form__trap {
    position: absolute;
    inset-inline-start: -200vw;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
  }
  /* Send, then what happens next and the two faster routes, then the small print. */
  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin-block-start: var(--s-6);
  }
  .form__promise {
    max-inline-size: 22em;
    color: var(--text-2);
  }
  /* Inline links, but thumb-sized: the padding extends the target to 44px without moving the line. */
  .form__promise a {
    display: inline-block;
    padding-block: 0.75rem;
    margin-block: -0.75rem;
    white-space: nowrap;
  }
  .form__req {
    margin-inline-start: auto;
  }
  .form__status {
    min-block-size: 1.5em;
    margin-block-start: var(--s-4);
    color: var(--gold-200);
  }
  .form__fallback {
    margin-block-start: var(--s-4);
    padding: var(--s-5);
    border-inline-start: 2px solid var(--coral);
    background: var(--ink-800);
    color: var(--text-2);
  }
  .form__fallback[hidden] {
    display: none;
  }
  .form__fallback:focus {
    outline: none;
  }
  .form__fallback :global(strong) {
    color: var(--ivory);
  }
  .form__fallback :global(.form__routes) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    margin-block-start: var(--s-3);
  }
  .form__fallback :global(.form__routes a) {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
  }
</style>
