---
// Site chrome, top and bottom. Data: src/data/site.ts.
//
// The logo is the company's own artwork, untouched (BRIEF §3.10, <Logo>). It stands at the top-left
// of every page on the plain black ground and scrolls away with the page, so nothing ever passes
// behind it and it needs no plate, rim or scrim. The controls are separate and stay fixed:
//
//   ≥ 78rem   top right, two opaque islands: [pages] and [Call · WhatsApp · Enquire].
//             Once the page's first block has scrolled away, the pages island gives way to a
//             small [Menu] island in the same slot: every page is still one click away and the
//             enquiry is always in reach. The reach island never moves (no layout shift).
//   48–78rem  [Menu] and [Call · WhatsApp · Enquire].
//   < 48rem   [Menu] at the top right, and a dock at the bottom [Call · WhatsApp · Enquire]:
//             the same three routes, under the thumb, at every scroll position.
//   Menu      a native <dialog> (focus trap, Esc, inert page behind it) opened by src/client/ui.ts.
//             Without JavaScript the Menu control is what it is in the markup: a link to the
//             footer's full navigation.
//   Enquire   one solid gold thing per screen. While the page's first block is on screen (it
//             holds the page's own solid button), Enquire is the outlined twin; when that block
//             has gone, Enquire lights up solid; while an enquiry form is on screen (its send
//             button is solid) it is outlined again. The switches are html.is-past-hero and
//             html.is-at-form, set by ui.ts; without JavaScript Enquire simply stays outlined.
//   Entrance  the controls drop in on the first page of a visit only (html.is-return, set by the
//             inline script in Base.astro), so they hold still from page to page.
//
// The islands are opaque so they stay AA-legible over any photograph without dimming a pixel of it.
// Page rule: the first `--header-zone` of every page is plain ground (the <Hero> already keeps it).
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site, isCurrent } from '../data/site';

interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
const { nav, contact } = site;
---

<header class="site-header">
  <a class="brand" href="/"><Logo width={132} /></a>

  <div class="chrome" data-enter="drop">
    <nav class="island primary" aria-label="Primary">
      <ul class="primary__list">
        {
          nav.primary.map((item) => (
            <li>
              <a class="primary__link" href={item.href} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* A plain link to the footer navigation; ui.ts upgrades it to open the dialog. */}
    <a class="island menu-btn" href="#site-footer" data-menu-open>
      <span>Menu</span>
      <Icon name="menu" />
    </a>

    <div class="island island--reach">
      <a class="reach reach--call" href={contact.phone.href} aria-label={`Call ${contact.phone.label}`}>
        <Icon name="phone" />
        <span>Call</span>
        <span class="reach__text tnum">{contact.phone.label}</span>
      </a>
      <a class="reach reach--wa" href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp us">
        <Icon name="whatsapp" />
      </a>
      <Button class="reach__enquire" href={nav.cta.href} size="sm">{nav.cta.label}</Button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Menu">
  <div class="menu__bar">
    <a class="menu__brand" href="/"><Logo width={132} /></a>
    <button class="island menu-btn" type="button" data-menu-close>
      <span>Close</span>
      <Icon name="close" />
    </button>
  </div>
  <nav class="menu__nav" aria-label="All pages">
    <ul class="menu__list">
      {
        nav.menu.map((item, i) => (
          <li style={`--i:${i}`}>
            <a class="menu__link" href={item.href} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu__foot" style={`--i:${nav.menu.length}`}>
    <Button href={nav.cta.href} data-menu-link>{nav.cta.label}</Button>
    <a class="menu__reach" href={contact.phone.href}><Icon name="phone" /><span class="tnum">{contact.phone.label}</span></a>
    <a class="menu__reach" href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /><span>{contact.whatsapp.label}</span></a>
    <a class="menu__reach" href={contact.email.href}><Icon name="mail" /><span>{contact.email.label}</span></a>
  </div>
</dialog>

<nav class="dock" aria-label="Contact" data-dock>
  <a class="dock__item" href={contact.phone.href}><Icon name="phone" /><span>Call</span></a>
  <a class="dock__item" href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" /><span>WhatsApp</span></a>
  <a class="dock__item dock__item--solid" href={nav.cta.href}><span>{nav.cta.label}</span></a>
</nav>

<style>
  /* The header itself takes no room: the logo is placed on the page, the controls on the screen. */
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    block-size: 0;
    z-index: var(--z-header);
  }
  /* The logo: on the page's own black, top left, on the margin. Not fixed, never over a picture.
     Its clear space is the empty ground around it; nothing may come nearer than --s-4. */
  .brand,
  .menu__brand {
    display: block;
    inline-size: var(--logo-w);
  }
  .brand {
    position: absolute;
    inset-block-start: var(--header-top);
    inset-inline-start: max(var(--margin), (100% - var(--max)) / 2);
  }
  .brand :global(.logo),
  .menu__brand :global(.logo) {
    inline-size: 100%;
    block-size: auto;
  }
  /* The controls: fixed, top right, centred on the logo's height while the page is at the top. */
  .chrome {
    position: fixed;
    inset-block-start: calc(var(--header-top) + (var(--logo-h) - var(--header-h)) / 2);
    inset-inline-end: max(var(--margin), (100% - var(--max)) / 2);
    display: flex;
    align-items: center;
    gap: var(--s-3);
    view-transition-name: site-chrome;
    pointer-events: none; /* only the islands take clicks, never the gap between them */
  }
  .island {
    display: flex;
    align-items: center;
    min-block-size: var(--header-h);
    border-radius: var(--r-control);
    background: var(--ink-800);
    box-shadow: inset 0 0 0 1px var(--rim);
    pointer-events: auto;
  }
  .island--reach {
    display: none; /* phones: the dock carries these */
    gap: 0.15rem;
    padding-inline: 0.4rem;
  }

  .primary {
    display: none;
    padding-inline: 0.5rem;
  }
  .primary__list {
    display: flex;
    align-items: center;
  }
  .primary__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.85rem;
    border-radius: var(--r-control);
    font-size: var(--t-ui);
    font-weight: 500;
    font-stretch: 106%;
    line-height: 1;
    color: var(--stone-300);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-ui) ease, background-color var(--dur-ui) ease;
  }
  /* The current page: gold and underlined (colour alone is not enough, WCAG 1.4.1). */
  .primary__link[aria-current='page'] {
    color: var(--gold-200);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--gold-400);
    text-underline-offset: 0.45em;
  }

  .reach {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    min-inline-size: 2.75rem;
    justify-content: center;
    padding-inline: 0.7rem;
    border-radius: var(--r-control);
    color: var(--ivory);
    font-size: var(--t-ui);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-ui) ease, background-color var(--dur-ui) ease;
  }
  .reach__text {
    display: none;
  }
  /* Windows High Contrast drops box-shadows: islands and the dock get a real border. */
  @media (forced-colors: active) {
    .island,
    .dock {
      border: 1px solid ButtonText;
    }
  }
  .island--reach :global(.reach__enquire) {
    display: none;
    margin-inline-start: 0.35rem;
  }
  /* Enquire is outlined while the page's first block (and its own solid button) is on screen,
     and again while an enquiry form (and its solid send button) is. */
  :global(html:is(:not(.is-past-hero), .is-at-form)) .island--reach :global(.reach__enquire) {
    background: none;
    color: var(--ivory);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  /* Menu (and Close in the dialog): an island of its own. */
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 1.2rem 1.05rem;
    color: var(--ivory);
    font-size: var(--t-ui);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: color var(--dur-ui) ease, background-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .primary__link:hover,
    .reach:hover {
      color: var(--gold-100);
      background: rgb(201 166 98 / 0.12);
    }
    /* An island stays opaque on hover: the page must never show through it. */
    .menu-btn:hover {
      color: var(--gold-100);
      background: color-mix(in srgb, var(--ink-800), var(--gold-400) 12%);
    }
    :global(html:is(:not(.is-past-hero), .is-at-form)) .island--reach :global(.reach__enquire:hover) {
      background: rgb(201 166 98 / 0.12);
      box-shadow: inset 0 0 0 1px var(--gold-300);
    }
  }

  /* ── The menu: the page names at display size, on the ground. */
  .menu {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: var(--header-top) var(--margin) calc(var(--s-6) + env(safe-area-inset-bottom));
    border: 0;
    background: var(--black);
    color: var(--ivory);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu:not([open]) {
    display: none;
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .menu::backdrop {
    background: var(--black);
  }
  /* Same places as on the page: the logo top left on the ground, the control top right. */
  .menu__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .menu__list {
    display: grid;
  }
  .menu__list li {
    border-block-start: 1px solid var(--rule);
  }
  .menu__list li:last-child {
    border-block-end: 1px solid var(--rule);
  }
  /* Rows of about 50px on a phone, so ten pages and the reach row fit one screen. */
  .menu__link {
    display: block;
    padding-block: 0.48em;
    font-family: var(--font-serif);
    font-size: var(--t-h3);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ivory);
    text-decoration: none;
  }
  .menu__link[aria-current='page'] {
    color: var(--gold-200);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--gold-400);
    text-underline-offset: 0.2em;
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-5);
    margin-block-start: auto;
  }
  @media (min-width: 60rem) {
    .menu[open] {
      gap: var(--s-7);
    }
    .menu__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .menu__list li:nth-last-child(2) {
      border-block-end: 1px solid var(--rule);
    }
  }
  .menu__reach {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    color: var(--stone-300);
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] {
      animation: menu-in var(--dur-panel) var(--ease-drawer) backwards;
    }
    .menu[open] .menu__list li,
    .menu[open] .menu__foot {
      animation: enter-rise 700ms var(--ease-expo) backwards;
      animation-delay: calc(120ms + var(--i, 0) * 45ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translate3d(0, -1.5rem, 0);
    }
  }

  /* ── The dock (phones and tablets). Opaque, round, three routes. */
  .dock {
    position: fixed;
    inset: auto 0 calc(0.75rem + env(safe-area-inset-bottom)) 0;
    z-index: var(--z-header);
    display: grid;
    grid-template-columns: 1fr 1.15fr 1.1fr;
    gap: 0.25rem;
    inline-size: min(100% - 1.5rem, 26rem);
    margin-inline: auto;
    padding: 0.3rem;
    border-radius: var(--r-control);
    background: var(--ink-800);
    box-shadow: inset 0 0 0 1px var(--rim);
    transition: transform var(--dur-panel) var(--ease-drawer);
  }
  .dock__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-block-size: 3rem;
    border-radius: var(--r-control);
    color: var(--ivory);
    font-size: var(--t-small);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform var(--dur-press) var(--ease-out);
  }
  .dock__item:active {
    transform: scale(0.97);
  }
  .dock__item--solid {
    background: var(--gold-300);
    color: var(--black);
    box-shadow: inset 0 1px 0 rgb(255 244 218 / 0.7);
  }
  /* Out of the way while someone is typing in a form, or while the enquiry form itself is on screen. */
  .dock.is-away,
  :global(html:has(form :is(input, select, textarea):focus)) .dock {
    transform: translate3d(0, 160%, 0);
  }
  /* ── From 48rem: the three routes move up into the right island; the dock goes. */
  @media (min-width: 48rem) {
    .island--reach {
      display: flex;
    }
    .reach,
    .island--reach :global(.reach__enquire) {
      display: inline-flex;
    }
    .island--reach :global(.reach__enquire) {
      margin-inline-end: 0.15rem;
    }
    .dock {
      display: none;
    }
  }
  /* ── From 78rem: at the top of a page the pages are in the bar and the menu is not needed.
        Past the first block, the Menu island takes the pages island's slot. Both sit to the left
        of the reach island, so the swap moves nothing that stays on screen. */
  @media (min-width: 78rem) {
    .primary {
      display: flex;
    }
    .chrome > .menu-btn {
      display: none;
    }
    :global(html.is-past-hero) .primary {
      display: none;
    }
    :global(html.is-past-hero) .chrome > .menu-btn {
      display: inline-flex;
    }
  }
  /* The controls drop in once per visit, not on every page. */
  :global(html.is-return) .chrome {
    animation: none;
  }
  @media (min-width: 90rem) {
    .reach__text {
      display: inline;
    }
  }
</style>
