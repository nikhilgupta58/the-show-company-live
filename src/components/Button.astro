---
// The one button. `solid` is the only filled gold shape on a screen: use it once per view.
// `outline` is its quiet twin (same size, sits 12 to 28px beside it). An <a> when it has an
// href, otherwise a <button>. The label says what happens ("Send enquiry", not "Submit").
import Icon, { type IconName } from './Icon.astro';
interface Props {
  href?: string;
  variant?: 'solid' | 'outline';
  size?: 'md' | 'sm';
  icon?: IconName;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'solid', size = 'md', icon, type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {icon && <Icon name={icon} class="btn__icon" size="1.15em" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-block-size: 3.5rem;
    padding: 0 1.75rem;
    border-radius: var(--r-control);
    font-family: var(--font-sans);
    font-stretch: 112%;
    font-size: var(--t-ui);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-ui) ease,
      box-shadow var(--dur-ui) ease,
      color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }
  .btn--sm {
    min-block-size: 2.75rem;
    padding: 0 1.25rem;
    font-size: var(--t-small);
  }
  /* Solid: flat gold, lit from above by one hairline. No gradient, no glow of its own. */
  .btn--solid {
    background: var(--gold-300);
    color: var(--black);
    box-shadow: inset 0 1px 0 rgb(255 244 218 / 0.7);
  }
  .btn--outline {
    color: var(--ivory);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn[disabled],
  .btn[aria-disabled='true'] {
    cursor: progress;
    background: var(--gold-600);
  }
  .btn :global(.btn__icon) {
    transition: transform var(--dur-ui) var(--ease-out);
  }
  /* Windows High Contrast drops box-shadows and backgrounds: every button gets a real border. */
  @media (forced-colors: active) {
    .btn {
      border: 1px solid ButtonText;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .btn--solid:hover {
      background: var(--gold-100);
    }
    .btn--outline:hover {
      box-shadow: inset 0 0 0 1px var(--gold-300);
      background: rgb(201 166 98 / 0.12);
    }
    @media (prefers-reduced-motion: no-preference) {
      .btn:hover :global(.btn__icon) {
        transform: translateX(0.2em);
      }
    }
  }
</style>
